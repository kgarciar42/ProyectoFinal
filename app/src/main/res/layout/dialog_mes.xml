<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja para elegir el mes: el año arriba y los 12 meses en cuadritos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_hoja"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/fondo_manija" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Elegir mes"
        android:textColor="@color/texto_principal"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Cambiar de año -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAnioAnterior"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/fondo_circulo"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/texto_principal"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvAnio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/texto_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAnioSiguiente"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/fondo_circulo"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/texto_principal"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Aquí se ponen los 12 meses desde el código (3 columnas x 4 filas) -->
    <GridLayout
        android:id="@+id/gridMeses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="3" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Los meses con borde verde tienen movimientos"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMesActual"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="Ir al mes actual"
        android:textColor="@color/fondo_app"
        android:textStyle="bold"
        app:backgroundTint="@color/acento"
        app:cornerRadius="14dp" />

    <!-- Ver el año completo -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerAnio"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Ver todo el año"
        android:textColor="@color/acento"
        app:cornerRadius="14dp"
        app:strokeColor="@color/acento" />
</LinearLayout>