<?xml version="1.0" encoding="utf-8"?>
<!-- La pantalla de bloqueo que tapa todo hasta poner el PIN o la huella -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bloqueo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:clickable="true"
    android:elevation="30dp"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="48sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/app_name"
        android:textColor="@color/texto_principal"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ingresa tu PIN para continuar"
        android:textColor="@color/texto_secundario" />

    <EditText
        android:id="@+id/etPinBloqueo"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/fondo_campo"
        android:gravity="center"
        android:hint="PIN"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:minHeight="56dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario"
        android:textSize="24sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDesbloquear"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="Desbloquear"
        android:textColor="@color/fondo_app"
        android:textStyle="bold"
        app:backgroundTint="@color/acento"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUsarHuella"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Usar huella o bloqueo del teléfono"
        android:textColor="@color/acento"
        android:visibility="gone"
        app:cornerRadius="14dp"
        app:strokeColor="@color/acento" />

    <!-- Por si se me olvida el PIN -->
    <TextView
        android:id="@+id/btnOlvidePin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:text="¿Olvidaste tu PIN?"
        android:textColor="@color/acento"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>